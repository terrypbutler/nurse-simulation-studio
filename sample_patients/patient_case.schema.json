{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nurse-simulation/patient-case.schema.json",
  "title": "Synthetic nursing simulation case collection",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "title",
        "synthetic_data_notice",
        "field",
        "setting",
        "patient",
        "learning",
        "clinical",
        "initial_state",
        "time_events",
        "allowed_actions",
        "ai_contract",
        "facilitator_only",
        "debrief"
      ],
      "properties": {
        "case_id": { "type": "string", "pattern": "^PAT-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 5 },
        "synthetic_data_notice": { "const": "Entirely fictional training case" },
        "field": { "enum": ["adult nursing"] },
        "setting": { "type": "string" },
        "complexity": { "enum": ["introductory", "intermediate"] },
        "estimated_duration_minutes": { "type": "integer", "minimum": 5, "maximum": 60 },
        "patient": { "type": "object" },
        "learning": { "type": "object" },
        "clinical": { "type": "object" },
        "initial_state": { "type": "object" },
        "time_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeEvent" }
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        },
        "ai_contract": { "$ref": "#/$defs/aiContract" },
        "facilitator_only": { "type": "object" },
        "debrief": { "type": "object" }
      },
      "additionalProperties": false
    },
    "timeEvent": {
      "type": "object",
      "required": ["event_id", "at_minute", "when", "effects", "visible_cue"],
      "properties": {
        "event_id": { "type": "string" },
        "at_minute": { "type": "integer", "minimum": 0 },
        "when": { "type": "object" },
        "effects": { "type": "object" },
        "visible_cue": { "type": "string" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["action_id", "label", "preconditions", "effects", "reveals"],
      "properties": {
        "action_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string" },
        "preconditions": { "type": "object" },
        "effects": { "type": "object" },
        "reveals": { "type": "array", "items": { "type": "string" } },
        "blocked_message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "aiContract": {
      "type": "object",
      "required": ["allowed_context", "may_generate", "must_not_generate"],
      "properties": {
        "allowed_context": { "type": "array", "items": { "type": "string" } },
        "may_generate": { "type": "array", "items": { "type": "string" } },
        "must_not_generate": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
